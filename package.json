{
  "name": "conversation-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node --experimental-strip-types scripts/verify-logic.ts",
    "verify:reel": "node --experimental-strip-types scripts/verify-reel.ts",
    "verify:import": "node --experimental-strip-types scripts/verify-import.ts",
    "migrate-topics": "node --experimental-strip-types scripts/migrate-topics.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "description": "Spin a topic and talk about it against a timer, with a word bank you can upload your own list into.",
  "license": "MIT",
  "author": "Jinininn"
}
